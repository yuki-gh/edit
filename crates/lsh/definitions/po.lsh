#[display_name = "PO"]
#[path = "**/*.po"]
pub fn po() {
    until /$/ {
        yield other;

        if /#.*/ {
            yield comment;
        } else if /(msgid|msgstr)/ {
            yield keyword.other;
        } else if /\{\d+:?[A-Za-z]?\d?\}/ {
            // C#
            yield variable;
        } else if /%(\d\$)?['\+\- #]*[\d\.\*]*[A-Za-z]+/ {
            // C/C++, Java
            yield variable;
        }

        yield other;
    }
}
