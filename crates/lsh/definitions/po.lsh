#[display_name = "PO"]
#[path = "**/*.po"]
pub fn po() {
    until /$/ {
        yield other;

        if /#.*/ {
            yield comment;
        } else if /(msgid|msgstr)/ {
            yield keyword.other;
        } else if /(\{[0-9]\})/ {
            yield variable;
        }

        yield other;
    }
}
