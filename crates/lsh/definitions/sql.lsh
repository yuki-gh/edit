#[display_name = "SQL"]
#[path = "**/*.sql"]
pub fn sql() {
    until /$/ {
        yield other;

        if /[BNX]?'/ {
            loop {
                yield string;
                await input;
                if /''/ {}
                else if /'/ {
                    yield string;
                    break;
                }
            }
        } else if /E'/ {
            loop {
                yield string;
                await input;
                if /(''|\\.)/ {}
                else if /'/ {
                    yield string;
                    break;
                }
            }
        } else if /"/ {
            loop {
                yield string;
                await input;
                if /("")/ {}
                else if /"/ {
                    yield string;
                    break;
                }
            }
        } else if /--.*/ {
            yield comment;
        } else if /\/\*/ {
            loop {
                yield comment;
                await input;
                if /\*\// {
                    yield comment;
                    break;
                }
            }
        } else if /\{/ {
            loop {
                yield comment;
                await input;
                if /\}/ {
                    yield comment;
                    break;
                }
            }
        } else if /##?\w+\>/ {
            // MS SQL Server tempdb table name
            yield variable;
        } else if /#.*/ {
            yield comment;
        } else if /\[((?i:bit|varbinary|binary|(tiny|medium|long)?blob|bool|nchar|char|datetime2?|date|decimal|double precision|float|image|integer|(tiny|small|medium|big)?int|money|numeric|real|sysname|(tiny|medium|long)?text|timestamp|time|nvarchar|varchar2|varchar|xml))\]\>/ {
            // data types
            yield $1 as keyword.other;
        } else if /\[/ {
	    // MS SQL Server
            loop {
                yield other;
                await input;
                if /\]/ {
                    yield other;
                    break;
                }
            }
        } else if /(?i:bit|varbinary|binary|(tiny|medium|long)?blob|bool|nchar|char|datetime2?|date|decimal|double precision|float|image|integer|(tiny|small|medium|big)?int|money|numeric|real|sysname|(tiny|medium|long)?text|timestamp|time|nvarchar|varchar2|varchar|xml)\>/ {
            // data types
            yield keyword.other;
        } else if /(?i:add|all|alter|analyze|and|any|asc|between|case|check|collate|column|constraint|continue|create|cross|current_date|current_timestamp|current_time|current_user|database|declare|delete|default|desc|distinct|drop|else|end|except|exists|first|foreign|for|from|full|grant|group|having|include|index|inner|insert|intersect|into|join|key|kill|left|like|limit|next|not|order|primary|references|return|revoke|right|schema|select|set|some|table|union|unique|update|user|using|values|value|when|where|with)\>/ {
            // common reserved words
            yield keyword.other;
        } else if /(?i:atomic|authorization|begin|bulk|cache|call|cast|catch|checkpoint|close|nonclustered|clustered|coalesce|collection|columnstore|commit|concat|contract|current|cursor|deny|endpoint|event session|execute|exec|exit|explain|external|fetch|function|get|goto|hash|identity|increment|initially|leading|load|localtime|localtimestamp|lock|login|maxvalue|minvalue|message|modifies|only|open|option|outer|output|over|partition|percent|plan|prepare|print|procedure|public|purge|queue|range|read|returns|replace|revert|rollback|route|role|sequence|server|signal|specific|start|statistics|stop|synonym|then|throw|top|transaction|tran|trigger|truncate|trunc|try|type|use|view|while|write|xmlnamespaces|xml)\>/ {
            // implementation-specific reserved words
            yield keyword.other;
        } else if /(?i:after|apply|auto|block|caller|clear|configuration|connect|contains|credential|data source|dbcc|deallocate|disable|encryption|file format|filegroup|filter|generated always as row|governor|json|masked|master|matched|merge|owner|path|period for|pool|predicate|reconfigure|resource|scheme|scoped|security policy|self|setvar)\>/ {
            // MS SQL Server keywords
            yield keyword.other;
        } else if /(?i:true|false|null)\>/ {
            yield constant.language;
//        } else if /(?i:abs|avg|ceiling|ceil|conv|count|dec|degrees|floor|max|min|mod|now|power|pow|radians|random|rand|round|sign|sum|truncate|trunc)\>/ {
//            yield method;
        } else if /@@?\w+\>/ {
            yield variable;
        } else if /(?i:in|as|by|go|if|is|off|of|on|or|to)\>/ {
            yield keyword.other;
        } else if /(\w+)\s*\(/ {
            yield $1 as method;
        } else if /(?i:<>|>=|=>|<=|=|>|<|\+|-|\*|\/)/ {
            // operators
            yield keyword.control;
        } else if /(?:\d*\.\d+)\>/ {
            yield constant.numeric;
        } else if /(?:\d+)\>/ {
            yield constant.numeric;
        } else if /\w+/ {
            // Gobble word chars to align the next iteration on a word boundary.
        }

        yield other;
    }
}
