#[display_name = "SQL"]
#[path = "**/*.sql"]
pub fn sql() {
    until /$/ {
        yield other;

        if /[BNX]?'/ {
            loop {
                yield string;
                await input;
                if /''/ {}
                else if /'/ {
                    yield string;
                    break;
                }
            }
        } else if /E'/ {
            loop {
                yield string;
                await input;
                if /(''|\\.)/ {}
                else if /'/ {
                    yield string;
                    break;
                }
            }
        } else if /"/ {
            loop {
                yield string;
                await input;
                if /("")/ {}
                else if /"/ {
                    yield string;
                    break;
                }
            }
        } else if /\[/ {
	    // MS SQL Server
            loop {
                yield other;
                await input;
                if /\]/ {
                    yield other;
                    break;
                }
            }
        } else if /#.*/ {
            yield comment;
        } else if /--.*/ {
            yield comment;
        } else if /\/\*/ {
            loop {
                yield comment;
                await input;
                if /\*\// {
                    yield comment;
                    break;
                }
            }
        } else if /(?i:add|all|alter|analyze|and|any|asc|between|case|check|collate|column|constraint|continue|count|create|cross|current_date|current_timestamp|current_time|current_user|database|declare|delete|default|desc|distinct|drop|else|end|except|exists|for|foreign|from|full|grant|group|having|index|inner|insert|intersect|into|join|key|kill|left|like|limit|not|order|primary|references|return|revoke|right|schema|select|set|some|table|union|unique|update|user|using|values|when|where|with)\>/ {
            // common reserved words
            yield keyword.other;
        } else if /(?i:begin|cast|catch|coalesce|commit|cursor|exec|exit|explain|fetch|function|initially|leading|load|localtime|localtimestamp|lock|maxvalue|only|open|option|outer|output|over|partition|percent|plan|print|procedure|public|purge|range|read|returns|replace|rollback|then|throw|transaction|truncate|trunc|try|use|while|write)\>/ {
            // implementation-specific reserved words
            yield keyword.other;
        } else if /\[?(?i:bit|varbinary|binary|(tiny|medium|long)?blob|bool|nchar|char|datetime2?|date|decimal|double precision|float|integer|(tiny|small|medium|big)?int|numeric|real|(tiny|medium|long)?text|timestamp|time|nvarchar|varchar2|varchar)\]?\>/ {
            // data types
            yield keyword.other;
        } else if /(?i:true|false|null)\>/ {
            yield constant.language;
        } else if /(?i:abs|avg|ceiling|ceil|conv|count|dec|degrees|floor|max|min|mod|now|power|pow|radians|random|rand|round|sign|sum|truncate|trunc)\>/ {
            yield method;
        } else if /(\w+)\s*\(/ {
            yield $1 as method;
        } else if /@@?\w+\>/ {
            yield variable;
        } else if /(?i:in|as|by|go|if|is|off|of|on|or|to)\>/ {
            yield keyword.other;
        } else if /(?i:<>|>=|=>|<=|=|>|<|\+|-|\*|\/)/ {
            // operators
            yield keyword.control;
        } else if /(?:\d*\.\d+)\>/ {
            yield constant.numeric;
        } else if /(?:\d+)\>/ {
            yield constant.numeric;
        } else if /\w+/ {
            // Gobble word chars to align the next iteration on a word boundary.
        }

        yield other;
    }
}
