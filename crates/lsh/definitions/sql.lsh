#[display_name = "SQL"]
#[path = "**/*.sql"]
pub fn sql() {
    until /$/ {
        yield other;

        if /[BNX]?'/ {
            loop {
                yield string;
                await input;
                if /''/ {}
                else if /'/ {
                    yield string;
                    break;
                }
            }
        } else if /E'/ {
            loop {
                yield string;
                await input;
                if /(''|\\.)/ {}
                else if /'/ {
                    yield string;
                    break;
                }
            }
        } else if /"/ {
            loop {
                yield string;
                await input;
                if /("")/ {}
                else if /"/ {
                    yield string;
                    break;
                }
            }
        } else if /--.*/ {
            yield comment;
        } else if /\/\*/ {
            loop {
                yield comment;
                await input;
                if /\*\// {
                    yield comment;
                    break;
                }
            }
        } else if /\{/ {
            loop {
                yield comment;
                await input;
                if /\}/ {
                    yield comment;
                    break;
                }
            }
        } else if /##?\w+\>/ {
            // MS SQL Server tempdb table name
            yield variable;
        } else if /#.*/ {
            yield comment;
        } else if /\[((?i:year|varchar|varbinary|timestamp|time|smallint|real|precision|path|nvarchar|numeric|nclob|nchar|money|interval|integer|int|image|float|double|decimal|dec|date|datetime2|datetime|clob|character|char|boolean|blob|bit|binary))\]\>/ {
            // MS SQL Server data types
            yield $1 as keyword.other;
        } else if /\[/ {
            // MS SQL Server IDs
            loop {
                yield other;
                await input;
                if /\]/ {
                    yield other;
                    break;
                }
            }
        } else if /(?i:year|xml|varchar2|varchar|varbinary|urowid|tinytext|tinyint|tinyblob|timestamp|time|text|smallint|serial|rowid|real|raw|precision|polygon|point|path|nvarchar2|nvarchar|numeric|number|nclob|nchar|money|mediumtext|mediumint|mediumblob|longtext|longblob|long|json|interval|integer|int|geometry|float|enum|double|decimal|dec|datetime2|datetime|date|clob|character|char|boolean|bool|blob|bit|binary|bigint|bfile)\>/ {
            // data types
            yield keyword.other;
        } else if /(?i:zone|year|write|work|without|with|where|when|view|varying|varchar|values|using|user|update|unique|union|truncate|trigger|transaction|trailing|timestamp|time|then|temporary|table|system|start|some|smallint|set|session|select|second|schema|savepoint|rows|row|rollup|rollback|role|right|revoke|return|restrict|references|real|read|range|procedure|privileges|primary|preserve|prepare|precision|partition|over|outer|out|order|option|only|old|off|numeric|nowait|not|none|next|new|nchar|natural|national|minute|merge|localtimestamp|localtime|local|limit|like|level|left|leading|lateral|last|language|key|join|isolation|into|interval|intersect|integer|int|insert|inner|index|hour|having|grouping|group|grant|global|function|full|from|foreign|for|float|first|filter|exists|execute|except|escape|end|else|each|drop|double|distinct|desc|delete|default|declare|decimal|dec|deallocate|day|database|data|cursor|current_user|current_timestamp|current_time|current_date|current|cube|cross|create|continue|constraint|commit|column|coalesce|close|check|character|char|case|cascade|call|both|binary|between|begin|before|asc|array|any|and|alter|all|after|admin|add)\>/ {
            // common keywords
            yield keyword.other;
        } else if /(?i:zerofill|yes|year_month|xor|xmlvalidate|xmltext|xmltable|xmlserialize|xmlroot|xmlquery|xmlpi|xmlparse|xmlnamespaces|xmliterate|xmlforest|xmlexists|xmlelement|xmldocument|xmlconcat|xmlcomment|xmlcolattval|xmlcast|xmlbinary|xmlattributes|xmlagg|xml|xid|x509|writetext|wrapper|within group|within|window|width_bucket|whitespace|while|whenever|when|weight_string|week|warnings|waitfor|wait|volume|volatile|visible|virtual|views|versions|version|verbose|vector|vcpu|varray|variadic|variables|variable|varchar2|varbinary|var_samp|var_pop|value|validator|validation|validate|valid|vacuum|utc_timestamp|utc_time|utc_date|user_resources|user_defined|use_stored_outlines|use_frm|use|usage|urowid|url|upsert|upgrade|updatetext|updatable|upd_indexes|unused|unusable|until|unsigned|unregister|unquiesce|unprotected|unpacked|unnest|unlogged|unlock|unlisten|unknown|uninstall|uniform|unicode|unencrypted|undofile|undo_buffer_size|undo|undetermined|under|undefined|unconditional|uncommitted|unbounded|unbound|unarchived|uid|uescape|uba|ub2|types|type|tuning|tsequal|try_convert|trusted|trim|triggers|treat|translation|translate_regex|transitional|transform|tran|tracking|tracing|trace|toplevel|top|tls|tinytext|tinyint|tinyblob|timezone_region|timezone_minute|timezone_hour|timezone_abbr|timestampdiff|timestampadd|timeout|ties|tier|through|thread_priority|thread|the|than|textsize|text|test|terminated|terminate|temptable|template|tempfile|temp|target|tabno|tablespace_no|tablespace|tablesample|tables|table_name|table_checksum|systimestamp|system_user|sysoper|sysdba|sysdate|sys_op_ntcimg|sys_op_noexpand|sys_op_lvl|sys_op_itr|sys_op_col_outer|sys_op_cast|sys_op_bitvec|synonym|symmetric|switches|switch|swaps|suspend|support|supplemental|super|summary|successful|substring_regex|substring|subpartitions|subpartition|submultiset|subject|subclass_origin|structure|strip|string|strict|streams|stream|straight_join|stored|store|storage|stop|stdout|stdin|stddev_samp|stddev_pop|stay|status|stats_sample_pages|stats_persistent|stats_auto_recalc|statistics|static|statement_id|statement|state|startup|starts|starting|standby|stacked|ssl|srid|sqlwarning|sqlstate|sqlldr|sqlexception|sqlerror|sqldata|sql_tsi_year|sql_tsi_week|sql_tsi_second|sql_tsi_quarter|sql_tsi_month|sql_tsi_minute|sql_tsi_hour|sql_tsi_day|sql_trace|sql_thread|sql_small_result|sql_no_cache|sql_calc_found_rows|sql_buffer_result|sql_big_result|sql_before_gtids|sql_after_mts_gaps|sql_after_gtids|sql|spreadsheet|split|spfile|specifictype|specification|specific|spatial|space|source_zstd_compression_level|source_user|source_tls_version|source_tls_ciphersuites|source_ssl_verify_server_cert|source_ssl_key|source_ssl_crlpath|source_ssl_crl|source_ssl_cipher|source_ssl_cert|source_ssl_capath|source_ssl_ca|source_ssl|source_retry_count|source_public_key_path|source_port|source_password|source_log_pos|source_log_file|source_host|source_heartbeat_period|source_delay|source_connect_retry|source_compression_algorithms|source_bind|source_auto_position|source|sounds|sort|soname|socket|snapshot|slow|slave|skip_unusable_indexes|skip|size|single|simple|similar|signed|signal|sid|siblings|shutdown|shrink|show|shared_pool|shared|share|setuser|settings|sets|setof|sessiontimezone|sessions_per_user|session_user|session_cached_cursors|service_name_convert|service|servererror|server|serializable|serial|sequential|sequences|sequence|separator|sensitive|semanticsimilaritytable|semanticsimilaritydetailstable|semantickeyphrasetable|self|selective|segment|seed|securityaudit|security|securefile|secret|secondary_unload|secondary_load|secondary_engine_attribute|secondary_engine|secondary|second_microsecond|search|sd_show|sd_all|scroll|scope|scn|schemas|schema_name|scheduler|schedule|scan_instances|scan|scalar|sb4|save|sample|salt|rules|rule|rtree|rowdependencies|rowcount|row_number|row_format|row_count|routines|routine|rotate|roles|rlike|rewrite|revert|reverse|reuse|returns|returning|returned_sqlstate|retention|retain|resume|result_cache|result|restricted|restore|restart|respect|resource|resolver|resolve|resize|resignal|resetlogs|reset|require_row_format|require|replication|replicate_wild_ignore_table|replicate_wild_do_table|replicate_rewrite_db|replicate_ignore_table|replicate_ignore_db|replicate_do_table|replicate_do_db|replicas|replica|replace|repeatable|repeat|repair|reorganize|rename|remove|remote_mapped|rely|reload|release|relaylog|relay_thread|relay_log_pos|relay_log_file|relay|relative|relational|reject|reindex|regr_syy|regr_sxy|regr_sxx|regr_slope|regr_r2|regr_intercept|regr_count|regr_avgy|regr_avgx|registration|regexp_like|refresh|referencing|reference|ref|redundant|reduced|redo_buffer_size|redo|redaction|recycle|recursive|recovery|recover|records|reconfigure|recheck|rebuild|reassign|readtext|reads|read_write|read_only|raw|rank|random|quotes|quote|quota|quick|queue|query|quarter|qualify|purge|publication|public|proxy|protection|property|project|program|profiles|profile|processlist|process|procedures|procedural|proc|privilege|private_sga|private|prior|prev|prepared|preceding|precedes|pragma|power|post_transaction|port|polygon|policy|point|plugins|plugin_dir|plugin|plsql_warnings|plsql_optimize_level|plsql_debug|plsql_code_type|plans|plan|placing|pivot|physical|phase|pfile|persist_only|persist|permanent|period|performance|percent_rank|percent|pending|pctversion|pctused|pctthreshold|pctfree|path|password_verify_function|password_reuse_time|password_reuse_max|password_lock_time|password_life_time|password_grace_time|password|passing|partitions|partitioning|partially|partial|parser|parse_tree|parameters|parameter|parallel|page|pad|packages|package|pack_keys|owner|owned|overriding|overlay|overlaps|overflow|output|outline|outfile|others|organization|ordinality|options|optionally|optional|optimizer_goal|optimizer_costs|optimize|optimal|operator|openxml|openrowset|openquery|opendatasource|open|opaque|online|one|omit|oidindex|oid|offsets|offset|offline|objno_reuse|objno|object)\>/ {
            // semi-common keywords
            yield keyword.other;
        } else if /(?i:nvarchar2|nvarchar|number|nulls|nullif|ntile|nth_value|notnull|notify|notification|nothing|nosort|norowdependencies|normalized|normalize|noreverse|noresetlogs|norepair|norely|noparallel|nooverride|noorder|nomonitoring|nominvalue|nominimize|nomaxvalue|nologging|noguarantee|noforce|noentity|nodelay|nodegroup|nocycle|nocopy|nocompress|nocheck|noaudit|no_write_to_binlog|no_wait|nls_territory|nls_special_chars|nls_sort|nls_numeric_characters|nls_nchar_conv_excp|nls_length_semantics|nls_language|nls_lang|nls_iso_currency|nls_date_language|nls_date_format|nls_currency|nls_comp|nls_characterset|nls_calendar|never|network_namespace|network|nested_table_id|nested|needed|ndbcluster|ndb|nclob|nchar_cs|navigational|native|nan|namespace|names|named|name|mysql_errno|mutex|mutating|multiset|multipolygon|multipoint|multilinestring|movement|move|mount|month|monitoring|module|modify|modifies|modification|model|mode|mod|mlslabel|missing|minvalue|minute_second|minute_microsecond|mining|minimum|minimize|minextents|min_rows|migrate|middleint|microsecond|method|metadata|message_text|merge_action|memory|member|mediumtext|mediumint|mediumblob|medium|measures|maxvalue|maxtrans|maxsize|maxlogmembers|maxloghistory|maxlogfiles|maxinstances|maxextents|maxdatafiles|max_user_connections|max_updates_per_hour|max_size|max_rows|max_queries_per_hour|max_connections_per_hour|materialized|matched|match|master|mapping|map|manual|management|managed|manage|low_priority|loop|longtext|longblob|long|logs|logical_reads_per_session|logical_reads_per_call|logical|logging|logfile|log|locks|locked|lock|locator|location|lob|load|list|link|linestring|lines|lineno|linear|likec|like4|like2|library|levels|less|leaves|leave|least|leakproof|lead|ldap|layer|last_value|large|lag|label|kill|keys|keyring|key_length|key_block_size|kerberos|keep|json_value|json_textcontains|json_table|json_serialize|json_scalar|json_query|json_objectagg|json_object|json_exists|json_equal|json_arrayagg|json_array|json|job|java|iteration|iterate|issuer|isolation_level|isnull|ipc|io_thread|io_before_gtids|io_after_gtids|invoker|invisible|invalidate|intersection|interpreted|internal_use|internal_convert|intermediate|int8|int4|int3|int2|int1|instead|instantly|instantiable|instances|instance|install|insert_method|insensitive|input|inout|inline|initrans|initiate|initially|initialize|initial_size|initial|inherits|inherit|infile|individual|indicator|indextypes|indextype|indexes|indexed|indent|incremental|increment|including|include|inactive|in_list_iterator|import|implicit|immediate|ilike|ignore_server_ids|ignore|idle_time|idgenerators|identitycol|identity_insert|identity|identifier|identified|hosts|host|holdlock|hold|history|histogram|hintset|high_priority|high|hierarchy|help|heap|header|hashkeys|hash|handler|guard|guaranteed|guarantee|gtids|gtid_only|groups|group_replication|greatest|grants|goto|globally|global_topic_enabled|global_name|get_source_public_key|get_format|get|geometrycollection|geometry|geomcollection|generated|generate|general|gather_plan_statistics|fusion|functions|fulltext|freeze|freepointers|freelists|freelist|free|found|forward|format|force|follows|following|flush|float8|float4|flashback|flagger|fixed|first_value|first_rows|finish|fine|finalize|final|fillfactor|filesystem_like_logging|file_block_size|file|fields|fetch|feature|fbtscan|faults|fast|family|failover|failed_login_attempts|factor|extract|externally|external|extents|extent_size|extent|extends|extended|extend|express|export|explode|explain|expire|expansion|exit|exempt|exec|exclusive|excluding|exclude|exchange|exceptions|exception|every|events|event|evaluate|estimate|escaped|errors|error|equals|enum|entry|entity|enterprise|enqueue|engines|engine_attribute|engine|enforced|enforce|ends|end-exec|encryption|encrypted|encoding|enclosed|enable|empty|elseif|element|dynamic|duplicate|dumpfile|dump|dual|dst_upgrade_insert_conv|domain|document|dml_update|dml|div|distributed|distinguished|distinctrow|dismount|diskgroup|disk|disconnect|discard|disassociate|disable|directory|dimension|dictionary|diagnostics|deterministic|detached|detach|destructor|destroy|descriptor|description|describe|deref|dequeue|depth|depends|dependent|dense_rank|demand|delimiters|delimiter|delayed|delay_key_write|delay|degree|definition|definer|deferred|deferrable|default_auth|deep|decompress|decode|debug|ddl|dbcc|dba|db_role_change|datetime|date_mode|date|dataobjno|datafiles|datafile|dangling|cycle|cursor_sharing_exact|cursor_name|current_schema|current_role|current_path|current_default_transform_group|current_catalog|cume_dist|csv|create_stored_outlines|cpu_per_session|cpu_per_call|cpu|cost|corruption|corr|copy|convert|conversion|controlfile|context|contents|content|contains|container|constructor|constraints|constraint_schema|constraint_name|constraint_catalog|consistent|consider|connection|connect_time|connect|confirm|conditional|condition|concurrent|concat|compute|compression|compressed|composite_limit|component|completion|complete|compile|compatibility|compact|committed|comment|columns|column_value|column_name|column_format|collect|collation|collate|code|cluster|close_cached_open_cursors|clone|clob|client|clear|class_origin|class|cipher|chunks|child|checksum|checkpoint|charset|characteristics|char_cs|channel|changed|change|challenge_response|chained|chain|certificate|category|catalog_name|catalog|cast|cascaded|cardinality|capacity|cancel|called|cache_instances|cache|byte|bypass|bulk|build|buffer_pool|buffer_cache|buffer|buckets|btree|broadcast|breadth|bound|boolean|bool|body|blocksize|block|blob|bitmap|bit|binlog|binding|binary_float|binary_double|bigint|bigfile|bfile|bernoulli|bequeath|behalf|become|backup|availability|automatic|autoextend|autoallocate|auto|authorization|authid|authentication|authenticated|audit|attributes|attribute|attach|atomic|asymmetric|associate|assertion|asensitive|are|archivelog|archive|apply|application|append|and_equal|analyze|always|allow|allocate|alias|algorithm|aggregate|advisor|advise|activate|action|account|accessed|access|absolute|abort)\>/ {
            // semi-common keywords
            yield keyword.other;
        } else if /(?i:translate|substr|sqlcode|octet_length|nextval|lower|hours|fieldproc|fenced|erase|ending|editproc|dssize|disallow|dbinfo|days|currval|current_timezone|current_server|collid|collection|ccsid|capture|bufferpool|auxiliary|aux|asutime|array_agg|abs)\>/ {
            // IBM DB2 keywords
            yield keyword.other;
        } else if /(?i:unpivot|section|rowguidcol|raiserror|print|preorder|prefix|postfix|position_regex|percentile_disc|percentile_cont|operation|occurrences_regex|nonclustered|like_regex|fulltexttable|freetexttable|freetext|errlvl|deny|current_transform_group_for_type|covar_samp|covar_pop|corresponding|containstable|clustered|browse|break)\>/ {
            // MS SQL Server 2022 keywords
            yield keyword.other;
        } else if /(?i:try|catch|throw|exec|type|scoped|pool|governor|filegroup|containment|columnstore)\>/ {
            // more MS SQL Server 2022 keywords
            yield keyword.other;
        } else if /(?i:unrecoverable|unmount|unmatched|unload|unlimited|substitutable|rownum|rowid|required|register|present|parity|parent|novalidate|minus|inmemory|compress|asynchronous|async|ansi|anomaly|ancillary)\>/ {
            //  Oracle 23ai keywords
            yield keyword.other;
        } else if /(?i:sysid|subscription|standalone|stable|position|oids|nfkd|nfkc|nfd|nfc|logged|listen|granted|extension|expression|defaults|conflict|configuration|concurrently|comments|backward|assignment|analyse|also|absent)\>/ {
            //  PostgreSQL 17 keywords
            yield keyword.other;
        } else if /(?i:varcharacter|regexp|privilege_checks_user|hour_second|hour_minute|hour_microsecond|day_second|day_minute|day_microsecond|day_hour|databases|avg_row_length|autoextend_size|auto_increment|ascii|against|active|accessible)\>/ {
            //  MySQL 9.7 keywords
            yield keyword.other;
        } else if /(?i:true|false|null)\>/ {
            yield constant.language;
        } else if /@@?\w+\>/ {
            yield variable;
        } else if /(?i:as|at|by|if|in|is|no|off|of|on|or|to)\>/ {
            // common keywords
            yield keyword.other;
        } else if /(?i:xa|s3|oj|ln|io|id|go|do)\>/ {
            // semi-common keywords
            yield keyword.other;
        } else if /(\w+)\s*\(/ {
            yield $1 as method;
        } else if /(?i:<>|>=|=>|<=|=|>|<|\+|-|\*|\/)/ {
            // operators
            yield keyword.control;
        } else if /(?:\d*\.\d+)\>/ {
            yield constant.numeric;
        } else if /(?:\d+)\>/ {
            yield constant.numeric;
        } else if /\w+/ {
            // Gobble word chars to align the next iteration on a word boundary.
        }

        yield other;
    }
}
