#[display_name = "SQL"]
#[path = "**/*.sql"]
pub fn sql() {
    until /$/ {
        yield other;

        if /[BENX]?'/ {
            loop {
                yield string;
                await input;
                if /(''|\\.)/ {}
                else if /'/ {
                    yield string;
                    break;
                }
            }
        } else if /"/ {
            loop {
                yield string;
                await input;
                if /(""|\\.)/ {}
                else if /"/ {
                    yield string;
                    break;
                }
            }
        } else if /\[/ {
	    // MS SQL Server
            loop {
                yield other;
                await input;
                if /\]/ {
                    yield other;
                    break;
                }
            }
        } else if /#.*/ {
            yield comment;
        } else if /--.*/ {
            yield comment;
        } else if /\/\*/ {
            loop {
                yield comment;
                await input;
                if /\*\// {
                    yield comment;
                    break;
                }
            }
        } else if /(?i:add|all|alter|analyze|and|any|asc|avg|between|case|check|collate|column|constraint|continue|count|create|cross|current_date|current_timestamp|current_time|current_user|database|declare|delete|default|desc|distinct|drop|else|end|except|exists|for|foreign|from|full|grant|group|having|index|inner|insert|intersect|into|join|key|kill|left|like|limit|max|min|not|order|primary|references|return|revoke|right|schema|select|set|some|sum|table|union|unique|update|user|using|values|when|where|with)\>/ {
            // common reserved words
            yield keyword.other;
        } else if /(?i:begin|cast|catch|coalesce|commit|cursor|exec|exit|explain|fetch|function|initially|leading|load|localtime|localtimestamp|lock|maxvalue|only|open|option|outer|output|over|partition|percent|plan|print|procedure|public|purge|range|read|returns|replace|rollback|then|throw|transaction|truncate|trunc|try|use|while|write)\>/ {
            // implementation-specific reserved words
            yield keyword.other;
        } else if /(?i:binary|bigint|integer|int|varchar2|varchar|char|float|numeric|double|precision|real)\>/ {
            // data types
            yield keyword.other;
        } else if /(?i:true|false|null)\>/ {
            yield constant.language;
        } else if /(?i:in|as|by|is|off|of|on|or|to)\>/ {
            yield keyword.other;
        } else if /(?i:<>|>=|=>|<=|=|>|<|\+|-|\*|\/)/ {
            // operators
            yield keyword.control;
        } else if /(?:\d*\.\d+)\>/ {
            yield constant.numeric;
        } else if /(?:\d+)\>/ {
            yield constant.numeric;
        } else if /\w+/ {
            // Gobble word chars to align the next iteration on a word boundary.
        }

        yield other;
    }
}
