#[display_name = "Batch file"]
#[path = "**/*.bas"]
#[path = "**/*.n"]
#[path = "**/*.n88"]
#[path = "**/*.n80"]
#[path = "**/*.n60"]
#[path = "**/*.sr"]
pub fn basic() {
    until /$/ {
        yield other;

        if /"/ {
            double_quote_string();
        } else if /(REM .*|\'.*|REM)/ {
            yield comment;
        } else if /(?:GOTO|GOSUB|RETURN|IF|THEN|ELSE|WHILE|WEND|FOR|TO|STEP|NEXT|ERROR|RESUME|CALL|EXEC)/ {
	    // control statements
            yield keyword.control;
        } else if /(?:END|PRINT|INPUT|DATA|DIM|READ|LET|RESTORE|CLEAR|WAIT|DEF|POKE|OUT|LPRINT|CONSOLE|WIDTH|SWAP|ERASE|DEFSTR|DEFINT|DEFSNG|DEFDBL|LINE|WRITE|PLAY|BGM|SOUND|COMMON|CHAIN|OPTION|BASE|RANDOMIZE|DSKO\$|OPEN|FIELD|GET|PUT|SET|CLOSE|MERGE|LSET|RSET|COLOR|CIRCLE|CLS|PSET|PRESET|PAINT|SCREEN|LOCATE|BEEP|ROLL|HELP|PALET|TALK|KANJI|PEN|CMD)/ {
	    // other statements
            yield keyword.other;
        } else if /(?:TAB|USR|FN\w+|SPC|NOT|ERL|ERR|STRING\$|USING|INSTR|VARPTR|ATTR\$|INKEY\$|AND|OR|XOR|EQV|IMP|MOD|LEFT\$|RIGHT\$|MID\$|SGN|INT|ABS|SQR|RND|SIN|LOG|EXP|COS|TAN|ATN|FRE|INP|POS|LEN|STR\$|VAL|ASC|CHR\$|PEEK|SPACE\$|OCT\$|HEX\$|LPOS|CINT|CSNG|CDBL|FIX|CVI|CVS|CVD|EOF|LOC|LOF|FPOS|MKI\$|MKS\$|MKD\$|DSKF|CSRLIN|DATE\$|STATUS|SEARCH|MAP)/ {
	    // functions and operators
            yield keyword.other;
        } else if /(?:RUN|LIST|NEW|CONT|LLIST|TRON|TROFF|EDIT|MENU|DELETE|AUTO|RENUM|CLOAD|CSAVE|LOAD|FILES|NAME|KILL|SAVE|LFILES|MON|COPY|TERM|BLOAD|BSAVE|MOTOR|COM|KEY|STICK|STRIG|PAD|GRP\$)/ {
	    // commands
            yield keyword.control;
        } else if /(?:VIEW|WINDOW|POINT|TIME\$)/ {
	    // statements/functions
            yield keyword.other;
        } else if /(?:ON|OFF|STOP)/ {
	    // operands
            yield keyword.other;
	} else if /(<>|>=|<=|=|>|<|\+|-|\*|\/|\^|\\)/ {
	    // opeators
	    yield keyword.control;
	} else if /(\d+|\d*\.\d+|\d*\.\d+[eEdD](\+-)?\d+\&H[0-9a-fA-F]+|\&O?[0-7]+)/ {
	    yield constant.numeric;
        } else if /\w+/ {
            // Gobble word chars to align the next iteration on a word boundary.
        }

        yield other;
    }
}
