#[display_name = "Gradle"]
#[path = "**/build.gradle"]
#[path = "**/build.gradle.kts"]
pub fn gradle() {
    if /\s*(task)\s+\w+/ {
        yield $1 as keyword.other;
        yield other;
    } else if /\s*(task|import|apply)\s+/ {
        yield keyword.other;
    } else if /\s*(\w+)\s*\{/ {
        yield $1 as keyword.other;
        yield other;
    }

    until /$/ {
        yield other;

        if /\/\/.*/ {
            yield comment;
        } else if /\/\*/ {
            loop {
                yield comment;
                await input;
                if /\*\// {
                    yield comment;
                    break;
                }
            }
        } else if /'/ {
            single_quote_string();
        } else if /"/ {
            double_quote_string();
        } else if /(?:(\w+)\.class)\>/ {
            yield $1 as keyword.other;
            yield other;
        } else if /(?:new\s+(\w+))\>/ {
            yield $1 as keyword.other;
            yield other;
        } else if /(?:type:\s*\w+)\>/ {
            yield keyword.other;
        } else if /(\w+)\s*\(/ {
            yield $1 as method;
        } else if /(?i:double|float|boolean|short|long|byte|string|character|char|integer|int)\>/ {
            yield keyword.other;
        } else if /(?i:true|false|null)\>/ {
            yield constant.language;
        } else if /-?\d*\.\d+[fF]/ {
            yield constant.numeric;
        } else if /-?\d*\.\d+(e[+-]?\d+)?/ {
            yield constant.numeric;
        } else if /-?\d+[lLfF]?/ {
            yield constant.numeric;
        } else if /\w+/ {
            // Gobble word chars to align the next iteration on a word boundary.
        }

        yield other;
    }
}
