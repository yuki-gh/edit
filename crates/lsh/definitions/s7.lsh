#[display_name = "S7"]
#[path = "**/*.scm"]
pub fn gradle() {
    until /$/ {
        yield other;

        if /#\\space|#\\./ {
            // character literal
            yield constant.numeric;
        } else if /;.*/ {
            yield comment;
        } else if /#\|/ {
            loop {
                yield comment;
                await input;
                if /\|#/ {
                    yield comment;
                    break;
                }
            }
        } else if /"/ {
            double_quote_string();
        } else if /('|,,@|,@|,|:)[A-Za-z0-9\.\*\/\+\-!\?<>=_]+/ {
            // atom
            yield constant.numeric;
        } else if /\*[A-Za-z0-9\.\/\+\-!\?<>=_]+\*/ {
            // system variable
            yield constant.numeric;
        } else if /\+[A-Za-z0-9\.\*\/\-!\?<>=_]+\+/ {
            // system variable
            yield constant.numeric;
        } else if /(?:require|provide|lambda|set\!|cons|define-macro|vector-ref|vector-set\!|vector|define|set-car\!|set-cdr\!|set|null\?|equal\?|pair\?|defined\?|eq\?|list|bignum|procedure\?|format|apply|c[ad]r|c[ad][ad]r|c[ad][ad][ad]r|eqv\?|memv|provided\?|symbol\?)\>/ {
            yield keyword.other;
        } else if /(?:begin|case|for-each|let\*|letrec\*|letrec|let|and|not|or|when|if|else|unless|do|call\/cc)\>/ {
            yield keyword.control;
        } else if /\(([a-z0-9\.\*\/\+\-!\?<>=_]+)( \))?/ {
            // function/macro
            yield $1 as method;
        } else if /\((\+|-|\*|\/|>=|<=|>|<|=) / {
            yield $1 as method;
        } else if /(?:#t|#f)\>/ {
            yield constant.language;
        } else if /-?\d*\.\d+/ {
            yield constant.numeric;
        } else if /-?\d+/ {
            yield constant.numeric;
        } else if /\w+/ {
            // Gobble word chars to align the next iteration on a word boundary.
        }

        yield other;
    }
}
