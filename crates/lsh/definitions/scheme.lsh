#[display_name = "S7"]
#[path = "**/*.scm"]
pub fn gradle() {
    until /$/ {
        yield other;

        if /#\\space|#\\./ {
            // character literal
            yield constant.numeric;
        } else if /;.*/ {
            yield comment;
        } else if /#\|/ {
            loop {
                yield comment;
                await input;
                if /\|#/ {
                    yield comment;
                    break;
                }
            }
        } else if /"/ {
            double_quote_string();
        } else if /('|,,@|,@|,|:)[A-Za-z0-9\.\*\/\+\-!\?<>=_]+/ {
            // atom
            yield constant.numeric;
        } else if /\*[A-Za-z0-9\.\/\+\-!\?<>=_]+\*/ {
            // special variable
            yield constant.numeric;
        } else if /\((\*[A-Za-z0-9\.\/\+\-!\?<>=_]+\*)/ {
            // special variable
            yield $1 as constant.numeric;
            yield other;
        } else if /\+[A-Za-z0-9\.\*\/\-!\?<>=_]+\+/ {
            // special variable
            yield constant.numeric;
        } else if /\((\+[A-Za-z0-9\.\*\/\-!\?<>=_]+\+)/ {
            // special variable
            yield $1 as constant.numeric;
            yield other;
        } else if /\((require|lambda\*|lambda|set\!|cons|define-macro|define-bacro\*|define-bacro|undefined\?|defined\?|define|vector-ref|vector-set\!|vector\?|vector|set-car\!|set-cdr\!|c[ad]+r|set|null\?|equal\?|pair\?|eq\?|list\?list|bignum|procedure\?|format|apply|eqv\?|memv|provided\?|provide|symbol\??|string\??|integer\??|boolean\??|real\??|float\??|char\??|c-pointer\?|memq)(\s+|$)/ {
            // TODO: closing paren
            yield $1 as keyword.other;
            yield other;
        } else if /\((begin|case|for-each|let\*|letrec\*|letrec|let|and|not|or|when|if|else|unless|do|call\/cc|cond|return)(\s+|$)/ {
            yield $1 as keyword.control;
            yield other;
        } else if /\(([a-z0-9\.\*\/\+\-!\?<>=_]+)( \))?/ {
            // function/macro
            // TODO: exclude let vars, lambda args, car of list
            yield $1 as method;
            yield other;
        } else if /\((\+|-|\*|\/|>=|<=|>|<|=) / {
            yield $1 as method;
            yield other;
        } else if /(?:#t|#f)\>/ {
            yield constant.language;
        } else if /-?\d*\.\d+/ {
            yield constant.numeric;
        } else if /-?\d+/ {
            yield constant.numeric;
        } else if /\w+/ {
            // Gobble word chars to align the next iteration on a word boundary.
        }

        yield other;
    }
}
