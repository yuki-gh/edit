#[display_name = "Scheme"]
#[path = "**/*.scm"]
pub fn scheme() {
    until /$/ {
        yield other;

        if /#\\\w+|#\\./ {
            // character literal
            yield constant.numeric;
        } else if /;.*/ {
            yield comment;
        } else if /#\|/ {
            loop {
                yield comment;
                await input;
                if /\|#/ {
                    yield comment;
                    break;
                }
            }
        } else if /#!/ {
            loop {
                yield comment;
                await input;
                if /!#/ {
                    yield comment;
                    break;
                }
            }
        } else if /"/ {
            loop {
                yield comment;
                await input;
                if /\\./ {
                } else if /"/ {
                    yield comment;
                    break;
                }
            }
        } else if /('|,,@|,@|,|:)[A-Za-z0-9\.\*\/\+\-!\?<>=_]+/ {
            // atom
            yield constant.numeric;
        } else if /\*[A-Za-z0-9\.\/\+\-!\?<>=_]+\*/ {
            // special variable
            yield constant.numeric;
        } else if /\((\*[A-Za-z0-9\.\/\+\-!\?<>=_]+\*)/ {
            // special variable
            yield $1 as constant.numeric;
            yield other;
        } else if /\+[A-Za-z0-9\.\*\/\-!\?<>=_]+\+/ {
            // special variable
            yield constant.numeric;
        } else if /\((\+[A-Za-z0-9\.\*\/\-!\?<>=_]+\+)/ {
            // special variable
            yield $1 as constant.numeric;
            yield other;
        } else if /\((undefined\?|provided\?|float\?|define-macro|defined\?)(\s+|$)/ {
            // TODO: closing paren
            yield $1 as keyword.other;
            yield other;
        } else if /(?:\#([su](8|16|32|64))|f(16|32|64)|c(32|64|128))\>/ {
            // Gauche uniform vector
            yield keyword.other;
        } else if /\((zero\?|write-char|write|with-output-to-file|with-input-from-file|when|vector-set!|vector-ref|vector-length|vector-fill!|vector->list|vector\?|vector|values|unquote-splicing|unquote|unless|truncate|tan|syntax-rules|syntax-error|symbol->string|symbol\?|substring|string-set!|string-ref|string-length|string-fill!|string-copy|string-ci>=\?|string-ci>\?|string-ci=\?|string-ci<=\?|string-ci<\?|string-append|string->symbol|string->list|string>=\?|string>\?|string=\?|string<=\?|string<\?|string\?|string|sqrt|sin|set-cdr!|set-car!|set!|scheme-report-environment|round|reverse|remainder|real\?|read-char|read|rational\?|quotient|quote|quasiquote|procedure\?|positive\?|port\?|peek-char|parameterize|pair\?|output-port\?|or|open-output-file|open-input-file|odd\?|numerator|number\?|null-environment|null\?|not|newline|negative\?|modulo|memv|memq|member|map|make-vector|make-string|log|load|list->vector|list->string|list\?|list\*?|let-values|let-syntax|letrec-syntax|letrec\*?|let\*?-values|let\*?|length|lcm|lambda\*?|interaction-environment|integer->char|integer\?|input-port\?|inexact->exact|inexact\?|include-ci|include|if|guard|gcd|for-each|force|floor|expt|exp|exact->inexact|exact\?|even\?|eval|error|eqv\?|equal\?|eq\?|eof-object\?|dynamic-wind|do|display|denominator|delay-force|delay|define-syntax|define|current-output-port|current-input-port|cos|cons|cond-expand|cond|complex\?|close-output-port|close-input-port|char-whitespace\?|char-upper-case\?|char-upcase|char-numeric\?|char-lower-case\?|char-downcase|char-ci>=\?|char-ci>\?|char-ci=\?|char-ci<=\?|char-ci<\?|char-alphabetic\?|char->integer|char>=\?|char>\?|char=\?|char<=\?|char<\?|char\?|ceiling|case-lambda|case|call-with-values|call-with-output-file|call-with-input-file|call-with-current-continuation|call\/cc|bytevector\?|boolean\?|begin|atan|assv|assq|assoc|asin|apply|append|and|acos|abs)(\s+|$)/ {
            // TODO: closing paren
            yield $1 as keyword.other;
            yield other;
        } else if /\((symbol|set|require|real|provide|integer|format|float|else|char|c[ad]+r|boolean|bignum)(\s+|$)/ {
            // TODO: closing paren
            yield $1 as keyword.other;
            yield other;
        } else if /\(([a-z0-9\.\*\/\+\-!\?<>=_]+)( \))?/ {
            // function/macro
            // TODO: exclude let vars, lambda args, car of list
            yield $1 as method;
            yield other;
        } else if /\((\+|-|\*|\/|>=|<=|>|<|=) / {
            yield $1 as method;
            yield other;
        } else if /(?:#t|#f)\>/ {
            yield constant.language;
        } else if /-?\d*\.\d+/ {
            yield constant.numeric;
        } else if /-?\d+/ {
            yield constant.numeric;
        } else if /\w+/ {
            // Gobble word chars to align the next iteration on a word boundary.
        }

        yield other;
    }
}
