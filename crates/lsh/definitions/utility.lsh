fn single_quote_string() {
    until /$/ {
        if /\\./ {
            // Escape sequences
        } else if /'/ {
            yield string;
            break;
        }
    }
}

fn double_quote_string() {
    until /$/ {
        if /\\./ {
            // Escape sequences
        } else if /"/ {
            yield string;
            break;
        }
    }
}

fn c_comment() {
    loop {
        yield comment;
        await input;
        if /\*\// {
            yield comment;
            break;
        }
    }
}
